{
  "name": "novaz-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "test": "npm test -w packages/core && npm test -w workers/avisos",
    "check": "npm run check -w apps/web",
    "build": "npm run build -w apps/web",
    "db:generate": "npm run db:generate -w packages/core",
    "db:migrate:local": "npm run db:migrate:local -w apps/web",
    "deploy": "npm run deploy -w apps/web && npm run deploy -w workers/avisos"
  }
}
